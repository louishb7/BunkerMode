<file path="frontend/src/theme/theme.css">
/* Preflight fica desativado intencionalmente: preservar defaults de headings,
 * listas e formulários evita regressões nas telas existentes. A camada base
 * normaliza apenas o box model, a tipografia dos controles e o foco global. */
@layer theme, base, components, utilities;

@import "tailwindcss/theme.css" layer(theme);
@import "tailwindcss/utilities.css" layer(utilities);

/* Cada par expressa o mesmo papel em light/dark, sem inversão automática. */
@theme static {
  --color-canvas: light-dark(#f3f3f3, #181818);
  --color-peripheral: light-dark(#ebebeb, #1e1e1e);
  --color-surface: light-dark(#ffffff, #222222);
  --color-surface-subtle: light-dark(#fafafa, #1e1e1e);
  --color-surface-overlay: light-dark(#ffffff, #333333);
  --color-text-primary: light-dark(#171717, #f5f5f5);
  --color-text-secondary: light-dark(#525252, #c4c4c4);
  --color-text-muted: light-dark(#656565, #adadad);
  --color-border: light-dark(#e5e5e5, #444444);
  --color-border-strong: light-dark(#737373, #8a8a8a);

  --color-accent: light-dark(#b83e0b, #fb923c);
  --color-accent-hover: light-dark(#9a3412, #fdba74);
  --color-action: light-dark(#c2410c, #f97316);
  --color-action-hover: light-dark(#9a3412, #ea580c);
  --color-on-action: light-dark(#ffffff, #171717);
  --color-selection: light-dark(#f1f1f1, #303030);
  --color-selection-text: light-dark(#171717, #f5f5f5);
  --color-selection-border: light-dark(#c2410c, #fb923c);
  --color-focus-ring: light-dark(#c2410c, #fb923c);
  --color-success: light-dark(#166534, #86efac);
  --color-success-soft: light-dark(#ecfdf3, #1d3526);
  --color-warning: light-dark(#795310, #facc15);
  --color-warning-soft: light-dark(#fef9c3, #3a310d);
  --color-danger: light-dark(#9b3c39, #e5aaa4);
  --color-danger-hover: light-dark(#7d2d2a, #f0c1bc);
  --color-danger-soft: light-dark(#f5e8e5, #493432);
  --color-backdrop: light-dark(#17171766, #00000099);

  /* Nomes semânticos já consumidos pelas telas: mantêm a migração incremental. */
  --color-app: var(--color-canvas);
  --color-sidebar: var(--color-peripheral);
  --color-control-border: var(--color-border-strong);

  --font-sans:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --radius-control: 8px;
  --radius-card: 16px;
  --radius-dialog: 18px;
  --shadow-surface:
    0 2px 8px light-dark(#17171705, #00000014), 0 1px 2px light-dark(#17171705, #00000014);
  --shadow-overlay: 0 16px 48px light-dark(#17171726, #00000066);
  --spacing: 4px;
}

@layer base {
  :root {
    color-scheme: light dark;
  }

  :root[data-theme="light"] {
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    background: var(--color-canvas);
  }

  html {
    font-family: var(--font-sans);
    line-height: 1.5;
  }

  body {
    margin: 0;
    min-width: 0;
    color: var(--color-text-primary);
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  ::selection {
    background: var(--color-selection);
    color: var(--color-selection-text);
  }
}

@layer base {
  button,
  a,
  input,
  select,
  textarea {
    -webkit-tap-highlight-color: transparent;
  }
  button:not(:disabled),
  select:not(:disabled) {
    cursor: pointer;
  }
  svg {
    flex-shrink: 0;
  }
}

@layer components {
  .work-surface {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
  }
}

@layer components {
  .eyebrow {
    margin: 0 0 8px;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .section-heading h2 {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    font-size: 12px;
    color: var(--color-text-secondary);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .text-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .empty-copy {
    padding: 24px 0;
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .form-label {
    display: grid;
    gap: 8px;
    min-width: 0;
    font-size: 14px;
    font-weight: 500;
  }
  .form-field {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 9px 12px;
    border: 1px solid var(--color-control-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-size: 14px;
  }
  .skeleton-line {
    display: block;
    height: 16px;
    border-radius: 3px;
    background: var(--color-peripheral);
    animation: quiet-pulse 1.5s ease-in-out infinite alternate;
  }
  .home-orientation {
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    gap: 32px;
  }
  .home-heading {
    border-bottom: 1px solid var(--color-border);
    padding: 8px 0 22px;
  }
  .home-heading h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 48px);
    line-height: 1.15;
