  .calendar-day[aria-pressed="true"] .calendar-day-number {
    color: var(--color-on-action);
    background: var(--color-action);
    border-radius: 11px;
  }
  .calendar-today-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: transparent;
  }
  .calendar-day[aria-current="date"] .calendar-today-dot {
    background: var(--color-accent);
  }
  .execution-surface {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: 15px;
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
  }
  .week-rail {
    position: relative;
    padding-top: 16px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-subtle);
  }
  .week-rail-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 16px 8px;
  }
  .week-arrow {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-secondary);
  }
  .week-arrow:hover,
  .week-today:hover {
    background: var(--color-peripheral);
    color: var(--color-text-primary);
  }
  .week-period p {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-width: 170px;
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
  }
  .week-period svg {
    color: var(--color-accent);
  }
  .week-today {
    display: block;
    margin: -8px auto 12px;
    min-height: 28px;
    padding: 2px 10px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 11px;
  }
  .task-group-heading {
    margin: 0;
    padding: 16px 24px 7px;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .task-row {
    padding: 2px 16px;
    transition: background 0.15s ease;
  }
  .task-row:hover,
  .task-row:focus-within {
    background: var(--color-surface-subtle);
  }
  .task-row h3 {
    line-height: 1.35;
  }
  .task-meta {
    gap: 4px 12px;
    margin-top: 5px;
  }
  .task-details {
    min-height: 26px;
    border: 0;
    border-radius: 5px;
    padding: 2px 5px;
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 11px;
  }
  .task-details:hover {
    background: var(--color-peripheral);
    color: var(--color-text-primary);
  }
  @media (max-width: 639px) {
    .execution-surface {
      margin-inline: -8px;
      border-radius: 10px;
    }
    .calendar-strip {
      padding-inline: 4px;
    }
    .calendar-day-number {
      width: 32px;
      height: 32px;
      font-size: 15px;
    }
    .week-rail-heading {
      gap: 0;
      padding-inline: 3px;
    }
    .week-period p {
      min-width: 0;
      font-size: 12px;
    }
    .task-row {
      padding-inline: 6px;
    }
    .home-orientation {
      gap: 26px;
    }
    .home-now {
      padding-left: 12px;
    }
    .home-actions li {
      font-size: 16px;
      gap: 4px;
    }
    .home-direction {
      grid-template-columns: 20px minmax(0, 1fr) 28px;
      gap: 10px;
    }
    .home-direction h3 {
      font-size: 20px;
    }
    .direction-reading {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .finance-resources {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .finance-resources dl {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    }
    .finance-resources dd {
      font-size: 17px;
    }
    .ledger-row {
      grid-template-columns: 18px minmax(0, 1fr) 44px;
      gap: 8px;
    }
    .ledger-amount {
      grid-column: 2;
      grid-row: 2;
    }
    .ledger-row > button {
      grid-column: 3;
      grid-row: 1 / 3;
    }
    .objective-links {
      padding: 0 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .skeleton-line {
      animation: none;
    }
  }
}
@keyframes quiet-pulse {
  from {
    opacity: 0.45;
  }
  to {
    opacity: 0.8;
  }
}

@layer components {
