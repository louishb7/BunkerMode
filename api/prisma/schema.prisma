generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model auditoria_eventos {
  evento_id  Int       @id @default(autoincrement())
  missao_id  Int?
  usuario_id Int?
  acao       String    @db.VarChar(80)
  detalhes   String
  criado_em  DateTime  @default(now()) @db.Timestamp(6)
  missoes    missoes?  @relation(fields: [missao_id], references: [missao_id], onDelete: SetNull, onUpdate: Cascade)
  usuarios   usuarios? @relation(fields: [usuario_id], references: [usuario_id], onDelete: SetNull, onUpdate: Cascade)

  @@index([missao_id])
  @@index([usuario_id])
}

model missoes {
  missao_id            Int                 @id @default(autoincrement())
  titulo               String              @db.VarChar(200)
  prioridade           Int                 @default(2)
  prazo                DateTime?           @db.Date
  instrucao            String?             @db.VarChar(280)
  status               String              @default("PENDENTE") @db.VarChar(20)
  is_pinned            Boolean             @default(false)
  created_at           DateTime            @default(now()) @db.Timestamp(6)
  updated_at           DateTime            @updatedAt @db.Timestamp(6)
  completed_at         DateTime?           @db.Timestamp(6)
  recurrence_series_id Int?
  criada_por_id        Int
  responsavel_id       Int
  objetivo_id          Int?
  auditoria_eventos    auditoria_eventos[]
  criada_por           usuarios            @relation("missoes_criada_por", fields: [criada_por_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)
  responsavel          usuarios            @relation("missoes_responsavel", fields: [responsavel_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)
  objetivos            objetivos?          @relation(fields: [objetivo_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  serie_recorrencia    series_recorrencia? @relation(fields: [recurrence_series_id], references: [recurrence_series_id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([recurrence_series_id, prazo])
  @@index([responsavel_id, status, prazo])
  @@index([objetivo_id])
}

model series_recorrencia {
  recurrence_series_id Int        @id @default(autoincrement())
  responsavel_id       Int
  objetivo_id          Int?
  titulo               String     @db.VarChar(200)
  instrucao            String?    @db.VarChar(280)
  prioridade           Int        @default(2)
  /// A baseline exige NOT NULL e CHECK de dias válidos e lista não vazia.
  recurrence_weekdays  Int[]
  start_date           DateTime   @db.Date
  termination_policy   String     @default("sem_termino") @db.VarChar(20)
  end_date             DateTime?  @db.Date
  ativo                Boolean    @default(true)
  created_at           DateTime   @default(now()) @db.Timestamp(6)
  updated_at           DateTime   @updatedAt @db.Timestamp(6)
  missoes              missoes[]
  objetivos            objetivos? @relation(fields: [objetivo_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  responsavel          usuarios   @relation("series_recorrencia_responsavel", fields: [responsavel_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([responsavel_id, ativo])
  @@index([objetivo_id])
}

model objetivos {
  id                 Int                  @id @default(autoincrement())
  usuario_id         Int
  titulo             String               @db.VarChar(200)
  descricao          String?
  data_alvo          DateTime?            @db.Date
  status             String               @default("ativo") @db.VarChar(20)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @updatedAt @db.Timestamp(6)
  concluded_at       DateTime?            @db.Timestamp(6)
  order_index        Int                  @default(0)
  missoes            missoes[]
  series_recorrencia series_recorrencia[]
  usuarios           usuarios             @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([usuario_id, status])
}

model usuarios {
  usuario_id         Int                  @id @default(autoincrement())
  usuario            String               @unique @db.VarChar(80)
  email              String               @unique @db.VarChar(254)
  senha_hash         String
  auth_version       Int                  @default(0)
  password_resets    PasswordReset[]
  ativo              Boolean              @default(true)
  enabled_modules    String[]              @default(["tasks", "objectives"])
  timezone           String               @default("America/Recife") @db.VarChar(80)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @updatedAt @db.Timestamp(6)
  auditoria_eventos  auditoria_eventos[]
  missoes_criadas    missoes[]            @relation("missoes_criada_por")
  missoes_recebidas  missoes[]            @relation("missoes_responsavel")
  series_recorrencia series_recorrencia[] @relation("series_recorrencia_responsavel")
  objetivos          objetivos[]
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamp(6)
  usedAt    DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  user      usuarios  @relation(fields: [userId], references: [usuario_id], onDelete: Cascade)

  @@index([userId, usedAt])
}
