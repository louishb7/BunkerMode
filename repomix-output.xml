  const selectedDateApi = formatDateForApi(selectedDate)
  const selectedTasks = useMemo(
    () => board.dailyTasks.filter((task) => taskBelongsToDate(task, selectedDate, user?.timezone)),
    [board.dailyTasks, selectedDate, user?.timezone]
  )
  function openCreateForm() {
    setEditingTask(null)
    board.setFormStatus(emptyStatus)
    setFormOpen(true)
  }

  function openEditForm(task) {
    setEditingTask(task)
    board.setFormStatus(emptyStatus)
    setFormOpen(true)
  }

  async function createTask(payload) {
    const saved = await board.createTask(payload)
    if (saved?.persisted) {
      setFormOpen(false)
      setEditingTask(null)
    }
  }

  async function updateTask(taskId, payload) {
    const saved = await board.updateTask(taskId, payload)
    if (saved?.persisted) {
      setFormOpen(false)
      setEditingTask(null)
    }
  }

  async function deleteTask(task) {
    const removed = await board.deleteTask(task)
    if (removed?.persisted && editingTask?.id === task.id) {
      setEditingTask(null)
      setFormOpen(false)
    }
  }

  return (
    <>
      <section className="mx-auto grid max-w-[920px] gap-5">
        <PageHeader title="Tarefas" />

        <div className="empty:hidden">
          <StatusNotice status={board.status} />
        </div>
        <div className="execution-surface">
          <WeekPanel
            onToday={() => setSelectedDate(todayDate)}
            onNextWeek={() => setSelectedDate((current) => addDays(current, 7))}
            onPreviousWeek={() => setSelectedDate((current) => addDays(current, -7))}
            onSelectDate={(date) => setSelectedDate(startOfDay(date))}
            selectedDate={selectedDate}
            todayDate={todayDate}
            weekLabel={weekLabel}
            weekDays={weekDays}
          />

          <TasksPanel
            onCreateTask={openCreateForm}
            onStartFocus={onStartFocus}
            completeLoadingId={board.completeLoadingId}
            loading={board.taskLoading && !board.hasBoardSnapshot}
            onCompleteTask={board.completeTask}
            onDeleteTask={setDeleteTarget}
            onEditTask={openEditForm}
            onReopenTask={board.reopenTask}
            onTogglePin={board.toggleTaskPin}
            pinLoadingId={board.pinLoadingId}
            reopenLoadingId={board.reopenLoadingId}
            selectedDate={selectedDate}
            selectedTasks={selectedTasks}
            timezone={user?.timezone}
          />
        </div>
      </section>

      {formOpen && (
        <Dialog
          className="max-w-2xl"
          closeOnBackdrop={false}
          onClose={() => {
            setFormOpen(false)
            setEditingTask(null)
            board.setFormStatus(emptyStatus)
          }}
          title={editingTask ? "Editar tarefa" : "Nova tarefa"}
        >
          <TaskForm
            currentUser={user}
            editingTask={editingTask}
            initialPrazo={editingTask ? undefined : selectedDateApi}
            loading={board.formLoading}
            onCancel={() => {
              setFormOpen(false)
              setEditingTask(null)
              board.setFormStatus(emptyStatus)
            }}
            onCreate={createTask}
            onUpdate={updateTask}
            status={board.formStatus}
            timezone={user?.timezone}
          />
        </Dialog>
      )}

      {deleteTarget !== null && (
        <ConfirmDialog
          title="Remover tarefa"
          message={`"${deleteTarget?.titulo}" será removida das tarefas.`}
          confirmLabel="Remover"
          variant="danger"
          onCancel={() => setDeleteTarget(null)}
          onConfirm={() => {
            deleteTask(deleteTarget)
            setDeleteTarget(null)
          }}
        />
      )}
    </>
  )
}
</file>

<file path="api/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model auditoria_eventos {
  evento_id  Int       @id @default(autoincrement())
  missao_id  Int?
  usuario_id Int?
  acao       String    @db.VarChar(80)
  detalhes   String
  criado_em  DateTime  @default(now()) @db.Timestamp(6)
  missoes    missoes?  @relation(fields: [missao_id], references: [missao_id], onDelete: SetNull, onUpdate: Cascade)
  usuarios   usuarios? @relation(fields: [usuario_id], references: [usuario_id], onDelete: SetNull, onUpdate: Cascade)

  @@index([missao_id])
  @@index([usuario_id])
}

model missoes {
  missao_id            Int                 @id @default(autoincrement())
  titulo               String              @db.VarChar(200)
  prioridade           Int                 @default(2)
  prazo                DateTime?           @db.Date
  instrucao            String?             @db.VarChar(280)
  status               String              @default("PENDENTE") @db.VarChar(20)
  is_pinned            Boolean             @default(false)
  created_at           DateTime            @default(now()) @db.Timestamp(6)
  updated_at           DateTime            @updatedAt @db.Timestamp(6)
  completed_at         DateTime?           @db.Timestamp(6)
  recurrence_series_id Int?
  criada_por_id        Int
  responsavel_id       Int
  objetivo_id          Int?
  auditoria_eventos    auditoria_eventos[]
  criada_por           usuarios            @relation("missoes_criada_por", fields: [criada_por_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)
  responsavel          usuarios            @relation("missoes_responsavel", fields: [responsavel_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)
  objetivos            objetivos?          @relation(fields: [objetivo_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  serie_recorrencia    series_recorrencia? @relation(fields: [recurrence_series_id], references: [recurrence_series_id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([recurrence_series_id, prazo])
  @@index([responsavel_id, status, prazo])
  @@index([objetivo_id])
}

model series_recorrencia {
  recurrence_series_id Int        @id @default(autoincrement())
  responsavel_id       Int
  objetivo_id          Int?
  titulo               String     @db.VarChar(200)
  instrucao            String?    @db.VarChar(280)
  prioridade           Int        @default(2)
  /// A baseline exige NOT NULL e CHECK de dias válidos e lista não vazia.
  recurrence_weekdays  Int[]
  start_date           DateTime   @db.Date
  termination_policy   String     @default("sem_termino") @db.VarChar(20)
  end_date             DateTime?  @db.Date
  ativo                Boolean    @default(true)
  created_at           DateTime   @default(now()) @db.Timestamp(6)
  updated_at           DateTime   @updatedAt @db.Timestamp(6)
  missoes              missoes[]
  objetivos            objetivos? @relation(fields: [objetivo_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  responsavel          usuarios   @relation("series_recorrencia_responsavel", fields: [responsavel_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([responsavel_id, ativo])
  @@index([objetivo_id])
}

model objetivos {
  id                 Int                  @id @default(autoincrement())
  usuario_id         Int
  titulo             String               @db.VarChar(200)
  descricao          String?
  data_alvo          DateTime?            @db.Date
  status             String               @default("ativo") @db.VarChar(20)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @updatedAt @db.Timestamp(6)
  concluded_at       DateTime?            @db.Timestamp(6)
  order_index        Int                  @default(0)
  missoes            missoes[]
  series_recorrencia series_recorrencia[]
  acompanhamentos   acompanhamentos[]
  reservas           reservas_financeiras[]
  usuarios           usuarios             @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([usuario_id, status])
}

model usuarios {
  usuario_id         Int                  @id @default(autoincrement())
  usuario            String               @unique @db.VarChar(80)
  email              String               @unique @db.VarChar(254)
  senha_hash         String
  auth_version       Int                  @default(0)
  password_resets    PasswordReset[]
  ativo              Boolean              @default(true)
  enabled_modules    String[]              @default(["tasks", "objectives"])
  timezone           String               @default("America/Recife") @db.VarChar(80)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @updatedAt @db.Timestamp(6)
  auditoria_eventos  auditoria_eventos[]
  missoes_criadas    missoes[]            @relation("missoes_criada_por")
  missoes_recebidas  missoes[]            @relation("missoes_responsavel")
  series_recorrencia series_recorrencia[] @relation("series_recorrencia_responsavel")
  objetivos          objetivos[]
  acompanhamentos    acompanhamentos[]
  lancamentos        lancamentos_financeiros[]
  reservas           reservas_financeiras[]
}

model acompanhamentos {
  id          Int                            @id @default(autoincrement())
  objetivo_id Int?
  usuario_id  Int
  usuario     usuarios                       @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)
  titulo      String                         @db.VarChar(200)
  descricao   String?
  created_at  DateTime                       @default(now()) @db.Timestamp(6)
  updated_at  DateTime                       @updatedAt @db.Timestamp(6)
  objetivo    objetivos?                     @relation(fields: [objetivo_id], references: [id], onDelete: SetNull)
  ocorrencias ocorrencias_acompanhamento[]

  @@index([objetivo_id])
  @@index([usuario_id])
}

model ocorrencias_acompanhamento {
  id                Int             @id @default(autoincrement())
  acompanhamento_id Int
  occurred_at       DateTime        @default(now()) @db.Timestamp(6)
  created_at        DateTime        @default(now()) @db.Timestamp(6)
  acompanhamento    acompanhamentos @relation(fields: [acompanhamento_id], references: [id], onDelete: Cascade)

  @@index([acompanhamento_id, occurred_at])
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamp(6)
  usedAt    DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  user      usuarios  @relation(fields: [userId], references: [usuario_id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// BRL em centavos inteiros; nenhum cálculo monetário usa ponto flutuante.
model lancamentos_financeiros {
  id             Int      @id @default(autoincrement())
  usuario_id     Int
  titulo         String   @db.VarChar(200)
  tipo           String   @db.VarChar(20)
  categoria      String   @db.VarChar(60)
  valor_centavos Int
  data           DateTime @db.Date
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)
  usuario        usuarios @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@index([usuario_id, data, id])
}

model reservas_financeiras {
  id                Int        @id @default(autoincrement())
  usuario_id        Int
  objetivo_id       Int?
  titulo            String     @db.VarChar(200)
  valor_centavos    Int        @default(0)
  alvo_centavos     Int?
  created_at        DateTime   @default(now()) @db.Timestamp(6)
  updated_at        DateTime   @updatedAt @db.Timestamp(6)
  usuario           usuarios   @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)
  objetivo          objetivos? @relation(fields: [objetivo_id], references: [id], onDelete: SetNull)

  @@index([usuario_id, id])
  @@index([objetivo_id])
}
</file>

<file path="frontend/src/features/calendar/components/DaySelector.tsx">
import React from "react"

import { formatDateForApi } from "../../../utils/date"

const WEEK_LABELS = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"]

export default function DaySelector({ onSelectDate, selectedDate, todayDate, weekDays }) {
  return (
    <div className="calendar-strip" aria-label="Dias da semana">
      {weekDays.map((date) => {
        const apiDate = formatDateForApi(date)
        const selected = date.getTime() === selectedDate.getTime()
        const today = date.getTime() === todayDate.getTime()
        return (
          <button
            key={apiDate}
            aria-pressed={selected}
            aria-current={today ? "date" : undefined}
            aria-label={date.toLocaleDateString("pt-BR", {
              weekday: "long",
              day: "numeric",
              month: "long",
            })}
            className="calendar-day"
            type="button"
            onClick={() => onSelectDate(date)}
          >
            <span className="calendar-day-label">{WEEK_LABELS[date.getDay()]}</span>
            <span className="calendar-day-number">{String(date.getDate()).padStart(2, "0")}</span>
            <span className="calendar-today-dot" aria-hidden="true" />
          </button>
        )
      })}
    </div>
  )
}
